    {"id":"cl2t","type":"text","x":3412,"y":2763,"width":856,"height":204,"angle":0,"strokeColor":"#2b8a3e","backgroundColor":"transparent","fillStyle":"hachure","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"ĐẦU THÁNG — TRIỂN KHAI\n──────────────────────────────\n► CONTENT: Nhận brief → sản xuất\n   → duyệt → đăng theo lịch\n► DIGITAL: Setup campaign → A/B test\n   10% ngân sách → tối ưu → scale\n► CRM: Phân khúc KH phù hợp\n   → gửi email/SMS trước 48h\n   khi quảng cáo chạy","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":"cl2","originalText":"ĐẦU THÁNG — TRIỂN KHAI\n──────────────────────────────\n► CONTENT: Nhận brief → sản xuất\n   → duyệt → đăng theo lịch\n► DIGITAL: Setup campaign → A/B test\n   10% ngân sách → tối ưu → scale\n► CRM: Phân khúc KH phù hợp\n   → gửi email/SMS trước 48h\n   khi quảng cáo chạy","lineHeight":1.3,"boundElements":[],"groupIds":[]},

