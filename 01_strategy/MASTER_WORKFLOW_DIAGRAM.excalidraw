    {"id":"cr4t","type":"text","x":10,"y":2893,"width":2330,"height":44,"angle":0,"strokeColor":"#212529","backgroundColor":"transparent","fillStyle":"hachure","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"PHÂN LOẠI theo cấp độ → Trigger đặc biệt: 3 review C1 cùng ngày về cùng sản phẩm → Nâng lên C2","fontSize":14,"fontFamily":2,"textAlign":"center","verticalAlign":"middle","containerId":"cr4","originalText":"PHÂN LOẠI theo cấp độ → Trigger đặc biệt: 3 review C1 cùng ngày về cùng sản phẩm → Nâng lên C2","lineHeight":1.3,"boundElements":[],"groupIds":[]},

